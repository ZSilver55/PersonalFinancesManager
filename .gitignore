# ---- Secrets / local configuration (never commit real credentials) ----
# The API's appsettings hold the Google client secret, so keep them out of the repo.
# A sanitized appsettings.example.json is committed instead as a template.
BudgetManager.Api/appsettings.json
BudgetManager.Api/appsettings.Development.json
appsettings.*.local.json

.git/

# ASP.NET user secrets (if used) live outside the repo already, but ignore any stray copies.
secrets.json

